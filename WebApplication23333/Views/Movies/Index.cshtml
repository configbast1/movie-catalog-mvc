@model IEnumerable<Movie>

@{
    ViewData["Title"] = "Топ-10 фільмів";
}

<section class="page-head">
    <p class="eyebrow">Особистий рейтинг</p>
    <h1>Каталог фільмів</h1>
    <p class="lead">
        Дані завантажено з локальної бази даних SQL Server (<code>MovieCatalogDb</code>)
        через Entity Framework Core. Усього фільмів у списку: <strong>@Model.Count()</strong>.
    </p>
    <div class="page-actions">
        <a class="btn btn-accent" asp-action="Create">+ Додати фільм</a>
    </div>
</section>

<partial name="_Message" />

@if (!Model.Any())
{
    <div class="empty-state">
        <p>Список порожній. Додайте перший фільм.</p>
        <a class="btn btn-accent" asp-action="Create">+ Додати фільм</a>
    </div>
}
else
{
    <div class="movie-grid">
        @{
            var position = 1;
        }
        @foreach (var movie in Model)
        {
            <article class="movie-card">
                <a class="poster-link" asp-action="Details" asp-route-id="@movie.Id">
                    <div class="poster-wrap">
                        <img src="@movie.PosterPath" alt="Постер фільму «@movie.Title»" loading="lazy" />
                        <span class="rank">#@position</span>
                        <span class="rating">@movie.Rating.ToString("0.0")</span>
                    </div>
                </a>

                <div class="movie-body">
                    <h2 class="movie-title">
                        <a asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a>
                    </h2>

                    <p class="movie-meta">
                        <span class="year">@movie.ReleaseYear</span>
                        <span class="dot">•</span>
                        <span class="genre">@movie.Genre</span>
                    </p>

                    <p class="movie-director">
                        <span class="label">@Html.DisplayNameFor(m => m.Director):</span>
                        @movie.Director
                    </p>

                    <p class="movie-description">@movie.Description</p>

                    <div class="card-actions">
                        <a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@movie.Id">Деталі</a>
                        <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@movie.Id">Редагувати</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@movie.Id">Видалити</a>
                    </div>
                </div>
            </article>

            position++;
        }
    </div>
}
