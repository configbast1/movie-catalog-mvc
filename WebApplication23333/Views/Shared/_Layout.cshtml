<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Кінокаталог</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Movies" asp-action="Index">
                <span class="brand-mark">🎬</span>
                <span class="brand-text">Кінокаталог</span>
            </a>
            <nav class="site-nav">
                <a asp-controller="Movies" asp-action="Index">Каталог</a>
                <a asp-controller="Movies" asp-action="Create">+ Додати фільм</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>© @DateTime.Now.Year Кінокаталог — ASP.NET Core MVC + SQL Server (LocalDB) + EF Core</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
