@using System.Globalization
@using Kino.PL.Localization
@using Microsoft.AspNetCore.Http.Extensions

@{
    var current = CultureInfo.CurrentUICulture.Name;

    // повертаємось на ту саму сторінку, але без ?culture=..., щоб параметр не перебивав cookie
    var query = Context.Request.Query
        .Where(q => q.Key != "culture" && q.Key != "ui-culture")
        .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string>(q.Key, v ?? string.Empty)));
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{new QueryBuilder(query).ToQueryString()}";
}

<nav class="lang-switcher" aria-label="@L["Layout.Language"]">
    @foreach (var culture in AppCultures.All)
    {
        var isActive = culture.Code == current;

        <a asp-controller="Language" asp-action="Set"
           asp-route-culture="@culture.Code" asp-route-returnUrl="@returnUrl"
           class="@(isActive ? "is-active" : null)"
           aria-current="@(isActive ? "true" : null)"
           hreflang="@culture.Code" lang="@culture.Code"
           title="@culture.NativeName">@culture.ShortName</a>
    }
</nav>
