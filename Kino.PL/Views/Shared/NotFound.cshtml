@{
    ViewData["Title"] = L["Errors.NotFoundTitle"];
    Layout = "_Layout";
}

<section class="status-page">
    <p class="status-code">404</p>
    <h1>@L["Errors.NotFoundHeading"]</h1>
    <p class="lead">@L["Errors.NotFoundLead"]</p>
    <div class="page-actions">
        <a class="btn btn-accent" asp-controller="Movies" asp-action="Index">@L["Common.ToHome"]</a>
    </div>
</section>
