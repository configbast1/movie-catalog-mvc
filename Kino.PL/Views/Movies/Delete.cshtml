@model MovieDto

@{
    ViewData["Title"] = L["Delete.Title", Model.Title];
}

<a class="back-link" asp-action="Details" asp-route-id="@Model.Id">@L["Common.BackToMovie"]</a>

<section class="page-head">
    <p class="eyebrow danger">@L["Delete.Eyebrow"]</p>
    <h1>@L["Delete.Heading"]</h1>
    <p class="lead">@L["Delete.Lead"]</p>
</section>

<div class="confirm-card">
    <div class="confirm-poster">
        <img src="@Model.PosterPath" alt="@L["Common.PosterAlt", Model.Title]" />
    </div>

    <div class="confirm-body">
        <h2>@Model.Title</h2>

        <dl class="details-list">
            <dt>@Html.DisplayNameFor(m => m.Director)</dt>
            <dd>@Html.DisplayFor(m => m.Director)</dd>

            <dt>@Html.DisplayNameFor(m => m.Genre)</dt>
            <dd>@Html.DisplayFor(m => m.Genre)</dd>

            <dt>@Html.DisplayNameFor(m => m.ReleaseYear)</dt>
            <dd>@Html.DisplayFor(m => m.ReleaseYear)</dd>

            <dt>@Html.DisplayNameFor(m => m.Rating)</dt>
            <dd>@Model.Rating.ToString("0.0")</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">@L["Delete.Confirm"]</button>
            <a class="btn btn-ghost" asp-action="Index">@L["Common.Cancel"]</a>
        </form>
    </div>
</div>
