@model MovieViewModel

@{
    ViewData["Title"] = $"Редагування — {Model.Title}";
}

<a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Назад до фільму</a>

<section class="page-head">
    <p class="eyebrow">Редагування</p>
    <h1>@Model.Title</h1>
    <p class="lead">Змініть потрібні поля. Новий постер замінить поточний.</p>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="form-card" novalidate>
    <!-- Validation Summary Tag Helper: загальний блок з переліком усіх помилок -->
    <div asp-validation-summary="All" class="validation-summary"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PosterPath" />

    <div class="form-grid">
        <div class="form-field span-2">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="input" autocomplete="off" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-field span-2">
            <label asp-for="OriginalTitle"></label>
            <input asp-for="OriginalTitle" class="input" autocomplete="off" />
            <span asp-validation-for="OriginalTitle" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Director"></label>
            <input asp-for="Director" class="input" autocomplete="off" />
            <span asp-validation-for="Director" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Genre"></label>
            <input asp-for="Genre" class="input" autocomplete="off" />
            <span asp-validation-for="Genre" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="ReleaseYear"></label>
            <input asp-for="ReleaseYear" class="input" type="number" step="1" />
            <span asp-validation-for="ReleaseYear" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Rating"></label>
            <input asp-for="Rating" class="input" type="number" step="0.1" />
            <span asp-validation-for="Rating" class="field-error"></span>
        </div>

        <div class="form-field span-2">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="input" rows="5"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="form-field span-2">
            <label asp-for="PosterFile"></label>
            <div class="poster-preview">
                <img src="@Model.PosterPath" alt="Поточний постер" />
                <div>
                    <input asp-for="PosterFile" type="file" accept="image/*" class="input file-input" />
                    <span class="field-hint">JPG, JPEG, PNG, WEBP або GIF, до 5 МБ. Залиште поле порожнім, щоб зберегти поточний постер.</span>
                    <!-- Validation Message Tag Helper: помилка конкретного поля -->
                    <span asp-validation-for="PosterFile" class="field-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-accent">Зберегти зміни</button>
        <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Скасувати</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
