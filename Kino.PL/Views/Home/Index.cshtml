@model IEnumerable<MovieDto>

@{
    ViewData["Title"] = L["Top.Title"];
}

<section class="page-head">
    <p class="eyebrow">@L["Catalog.Eyebrow"]</p>
    <h1>@L["Top.Heading"]</h1>
    <p class="lead">@H["Catalog.Lead", "MovieCatalogDb", Model.Count()]</p>
</section>

<div class="movie-grid">
    @{
        var position = 1;
    }
    @foreach (var movie in Model)
    {
        <article class="movie-card">
            <a class="poster-link" asp-controller="Home" asp-action="Details" asp-route-id="@movie.Id">
                <div class="poster-wrap">
                    <img src="@movie.PosterPath" alt="@L["Common.PosterAlt", movie.Title]" loading="lazy" />
                    <span class="rank">#@position</span>
                    <span class="rating">@movie.Rating.ToString("0.0")</span>
                </div>
            </a>

            <div class="movie-body">
                <h2 class="movie-title">
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a>
                </h2>

                <p class="movie-meta">
                    <span class="year">@movie.ReleaseYear</span>
                    <span class="dot">•</span>
                    <span class="genre">@movie.Genre</span>
                </p>

                <p class="movie-director">
                    <span class="label">@Html.DisplayNameFor(m => m.Director):</span>
                    @movie.Director
                </p>

                <p class="movie-description">@movie.Description</p>
            </div>
        </article>

        position++;
    }
</div>
